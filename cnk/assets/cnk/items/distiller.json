          {"threshold":0, "model":{"type":"minecraft:model","model":"cnk:block/distiller/0"}},
          {"threshold":1, "model":{"type":"minecraft:model","model":"cnk:block/distiller/1"}},
          {"threshold":2, "model":{"type":"minecraft:model","model":"cnk:block/distiller/2"}},
          {"threshold":3, "model":{"type":"minecraft:model","model":"cnk:block/distiller/3"}},
          {"threshold":4, "model":{"type":"minecraft:model","model":"cnk:block/distiller/4"}},
          {"threshold":5, "model":{"type":"minecraft:model","model":"cnk:block/distiller/5"}}
        ]
      }
